{
  "name": "@theluckystrike/webext-bookmarks",
  "version": "1.0.0",
  "description": "Typed bookmark helpers for Chrome extensions — create, search, organize, and sync bookmarks with full tree support. Part of @zovo/webext.",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/theluckystrike/webext-bookmarks.git"
  },
  "homepage": "https://github.com/theluckystrike/webext-bookmarks#readme",
  "bugs": {
    "url": "https://github.com/theluckystrike/webext-bookmarks/issues"
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts",
    "test": "vitest run",
    "prepare": "npm run build"
  },
  "keywords": [
    "chrome",
    "extensions",
    "bookmarks",
    "webext",
    "zovo"
  ],
  "author": "theluckystrike",
  "license": "MIT",
  "packageManager": "pnpm@10.30.3",
  "engines": {
    "node": ">=18",
    "pnpm": ">=8"
  },
  "sideEffects": false,
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "devDependencies": {
    "@types/chrome": "^0.1.37",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vitest": "^4.0.18"
  }
}
